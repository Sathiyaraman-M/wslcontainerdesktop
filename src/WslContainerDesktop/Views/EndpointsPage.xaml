<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WslContainerDesktop.Views.EndpointsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:blazor="using:BlazorWinUI">

    <Page.Resources>
        <!-- These ThemeResource-backed styles keep the component aligned with the app's selected theme. -->
        <Style x:Key="EndpointSecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="EndpointTertiaryIconStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="EndpointAccentIconStyle" TargetType="FontIcon">
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="EndpointHeaderBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="EndpointBodyBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <blazor:BlazorComponentHost
        x:Name="RootHost"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        Renderer="{x:Bind Renderer, Mode=OneTime}"
        ComponentType="{x:Bind RootComponentType, Mode=OneTime}"
        HostError="RootHost_OnHostError" />
</Page>
